APP_NAME="Grupo Excelencia 360"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8360
# Puerto propio para `php artisan serve` (8000 lo usa CEBA en local).
# Debe coincidir con APP_URL.
SERVER_PORT=8360

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# Usar una base y un usuario MySQL propios, nunca los de CEBA.
# DB_DATABASE=excelencia360
# DB_USERNAME=excelencia360
# DB_PASSWORD=
# Solo necesario si mysqldump no está en el PATH (típico en Windows/XAMPP).
# DB_DUMP_BINARY_PATH=C:/xampp/mysql/bin

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Las cookies de localhost no distinguen puerto: con un nombre propio, la
# sesión de este sistema no pisa la de CEBA.
SESSION_COOKIE=excelencia360_session

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=excelencia360-cache-

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX=excelencia360-database-

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# 'null' simula el envío (log, sin credenciales); 'meta' llama a la
# WhatsApp Cloud API real y requiere las variables de abajo.
WHATSAPP_DRIVER=null
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Cifra los .zip de backup si se define; vacío = sin cifrar (ok en local).
BACKUP_ARCHIVE_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
